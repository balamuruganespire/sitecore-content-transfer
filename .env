# Pre-fills the "CM host" fields on load. Not secret (just a URL) — client credentials
# are still entered by hand and never persisted server-side.
NEXT_PUBLIC_SOURCE_CM_HOST=
NEXT_PUBLIC_TARGET_CM_HOST=

# Pre-fills the "Client ID"/"Client secret" fields via /api/env-defaults. Unlike the
# host, these ARE secrets: they round-trip to the browser on every page load and are
# visible in the network tab to anyone using the app. Local/trusted use only.
SOURCE_CLIENT_ID=
SOURCE_CLIENT_SECRET=
TARGET_CLIENT_ID=
TARGET_CLIENT_SECRET=

# When "true", the source/target host, Client ID, and Client secret fields always come
# from the env values above on load, ignoring anything saved in the browser tab's
# session storage from a previous run.
NEXT_PUBLIC_OVERRIDELOCALSTORAGE=true